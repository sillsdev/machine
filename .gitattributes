*.sh eol=lf
*.ts eol=lf
*.js eol=lf
*.json eol=lf
*.yml eol=lf
*.cfg eol=lf
*.ipynb eol=lf

# Frozen bytes: conformance/*/fieldworks/project.fwdata's exact SHA-256 is pinned in that
# fixture's phonology-mutations.yaml (see FieldWorksWitnessDirectoriesAreShapedCorrectly). Without
# this, a platform/config-dependent CRLF checkout of an otherwise-text XML file makes the hash
# non-reproducible across machines.
*.fwdata binary
