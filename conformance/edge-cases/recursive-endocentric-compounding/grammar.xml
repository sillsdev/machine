<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>RecursiveEndocentricCompounding</Name>
    <!-- Synthetic construct-shaped mimic (docs/conformance/representative-typology-basis.md
         S1.2.1 - "Compounding: recursive/self-feeding configuration"). Invented CVCV roots only,
         no natural-language lexemes. Representative typological pattern: recursive endocentric
         compounding, where a compound's own output part-of-speech is identical to (a supertype of)
         one of its own input parts-of-speech, so the compounding rule can in principle re-apply to
         its own output indefinitely - the ordinary engine behind English-style compound stacking
         ("state government tax policy committee meeting") and general N-N-recursive compounding
         rules. Germanic and Sinitic compounding are the families most
         commonly cited for unbounded endocentric N-N stacking (see the doc's own citations); the
         phenomenon itself is not family-specific.

         Structural shape: ONE CompoundingRuleDef ("cr1") whose headPartsOfSpeech/
         nonHeadPartsOfSpeech/outputPartOfSpeech all name the SAME PartOfSpeech ("posRoot") - the
         rule's own output re-enters its own input set - with multipleApplication left at its DTD
         maximum (9, the highest the schema's enumerated attribute allows) rather than the DTD
         default of 1, so a stratum can in principle build (root+root)+root...-shaped nesting.

         Per pg-foma::capability's own compounding_recursive (rust/crates/pg-foma/src/
         capability.rs), a CompoundingRuleDef with max_apps > 1 characterizes
         CharacteristicKind::Compounding as the "compounding.recursive" split unconditionally -
         this is a purely STRUCTURAL fact about the rule definition, independent of whether any
         particular word in this fixture actually exercises 3+ levels of nesting. This is exactly
         why this fixture exists: cover-compounding's own CompoundingRecursionSafePredicate
         (capability.rs) still Refuses this shape (see the paired rust/crates/pg-foma/tests/
         cover_recursive_endocentric_compounding.rs regression test), so this fixture's job is to
         pin that REFUSAL honestly, plus the oracle's (pg_parse::Morpher) own correct behavior on
         actual words - see this directory's STAGING.md for the oracle's own (independently
         discovered) additional resource-ceiling finding on genuinely-3-level words. -->
    <PartsOfSpeech>
      <PartOfSpeech id="posRoot"><Name>root</Name></PartOfSpeech>
    </PartsOfSpeech>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="ca"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="ce"><Representations><Representation>e</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="ci"><Representations><Representation>i</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cf"><Representations><Representation>f</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cl"><Representations><Representation>l</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cm"><Representations><Representation>m</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cr"><Representations><Representation>r</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cs"><Representations><Representation>s</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="ct"><Representations><Representation>t</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cv"><Representations><Representation>v</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="t1" morphologicalRuleOrder="linear" morphologicalRules="cr1">
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <CompoundingRule id="cr1" multipleApplication="9" headPartsOfSpeech="posRoot" nonHeadPartsOfSpeech="posRoot" outputPartOfSpeech="posRoot">
            <Name>Compound</Name>
            <CompoundingSubrules>
              <CompoundingSubrule>
                <HeadMorphologicalInput>
                  <PhoneticSequence id="h0"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence>
                </HeadMorphologicalInput>
                <NonHeadMorphologicalInput>
                  <PhoneticSequence id="n0"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence>
                </NonHeadMorphologicalInput>
                <MorphologicalOutput>
                  <CopyFromInput index="h0" />
                  <CopyFromInput index="n0" />
                </MorphologicalOutput>
              </CompoundingSubrule>
            </CompoundingSubrules>
          </CompoundingRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="eRoot1" partOfSpeech="posRoot">
            <Allomorphs><Allomorph id="aRoot1"><PhoneticShape>tevi</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT1</MorphemeId>
            <Gloss>root1</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eRoot2" partOfSpeech="posRoot">
            <Allomorphs><Allomorph id="aRoot2"><PhoneticShape>mafl</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT2</MorphemeId>
            <Gloss>root2</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eRoot3" partOfSpeech="posRoot">
            <Allomorphs><Allomorph id="aRoot3"><PhoneticShape>isra</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT3</MorphemeId>
            <Gloss>root3</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
