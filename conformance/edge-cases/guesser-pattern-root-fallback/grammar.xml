<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>GuesserPatternRootFallback</Name>
    <!-- Synthetic probe for the Guesser/LexicalGuess mechanism (HC-rust port audit sec 2
         "Partially ported" / sec 3 item 1; docs/p11-guesser-api-design.md), NOT modeling any real
         language. One lexical entry ("ePattern") is a LEXICAL PATTERN, not an ordinary root: its
         one allomorph's PhoneticShape "[Any]*" references a natural class with an EMPTY feature
         struct (matches every segment), so RootAllomorphDef::is_pattern is true for it and the
         loader partitions it out of the ordinary root-allomorph trie into
         Morpher::lexical_patterns (P11 chunk 1/2) - it can NEVER be found by normal lexical
         lookup, only by the guesser. A second, ordinary root entry ("eKad", surface "kad") is the
         control: a ROOT that IS trie-indexed and analyzes normally with guessing off, pinning that
         the guesser only ever fires on a genuine total miss, never overriding/duplicating a real
         lexical hit. -->
    <PartsOfSpeech>
      <PartOfSpeech id="posV"><Name>Verb</Name></PartOfSpeech>
    </PartsOfSpeech>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cG"><Representations><Representation>g</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cD"><Representations><Representation>d</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="cPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <!-- Empty feature struct: matches every segment (C#'s canonical Guesser test uses the same
           "Any" empty-FS class - MorpherTests.AnalyzeWord_CanGuess_ReturnsCorrectAnalysis,
           docs/p11-guesser-api-design.md sec 1.5). Referenced from PhoneticShape below by NAME
           ("Any"), not by this "ncAny" id (C# LoadNaturalClass keys _naturalClassLookup by <Name>). -->
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="t1" morphologicalRules="mrPast">
        <Name>Morphophonemic</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrPast" requiredPartsOfSpeech="posV">
            <Name>past_suffix</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subPast">
                <MorphologicalInput>
                  <PhoneticSequence id="stem">
                    <OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <CopyFromInput index="stem" />
                  <InsertSegments><PhoneticShape>+d</PhoneticShape></InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>PAST</MorphemeId>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="ePattern">
            <Allomorphs><Allomorph id="aPattern"><PhoneticShape>[Any]*</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>PATTERN</MorphemeId>
            <Gloss>pattern</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eKad" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aKad"><PhoneticShape>kad</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>KAD</MorphemeId>
            <Gloss>kad</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
