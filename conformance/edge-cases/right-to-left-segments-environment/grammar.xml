<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>RightToLeftSegmentsEnvironment</Name>
    <!-- Synthetic construct-shaped mimic (`openspec/changes/plan-construct-coverage-completion`
         task 4.2 - "RightToLeftRewrite: additional in-scope pattern shapes", the `Segments`
         shape). Invented VC roots only, no natural-language lexemes. Structural shape: one
         PhonRuleDef, multipleApplicationOrder="rightToLeftIterative", whose subrule's own
         RightEnvironment is authored as an INLINE pre-segmented literal
         (`<Segments characterDefinitionTable="t1"><PhoneticShape>y</PhoneticShape></Segments>`)
         instead of an ordinary `<SimpleContext>`/`<Segment>` reference - `characterDefinitionTable`
         is set EXPLICITLY to `t1` (the SAME table the rule's own stratum uses); hc.dll's own
         `XmlLanguageLoader.LoadRewriteSubrule` never threads a default table into an
         Environment's `PhoneticTemplate` (unlike a rule's main LHS/RHS), so an environment-embedded
         `<Segments>` with no explicit `characterDefinitionTable` resolves to a null table and
         crashes the loader with a bare `NullReferenceException` (verified empirically: an earlier
         draft omitting the attribute reproduced exactly that crash) - this is the SAME-table case
         `crate::lower::PatternLowerScope::RewriteRuleCompile` newly accepts (a `Segments` node
         referencing a DIFFERENT table stays refused - see `rust/crates/pg-foma/src/capability.rs`'s
         own `right_to_left_predicate_refuses_cross_table_segments_shaped_rule` unit test).

         Before this task, `pg_foma::replace::pattern_slots` refused ANY `PatternNode::Segments`
         occurrence grammar-wide (`crate::lower::UnsupportedPatternNode::Segments`'s own doc) -
         `crate::capability::RightToLeftRewriteFaithfulReversalPredicate` would `Refuse` this exact
         rule. It now accepts a same-table `Segments` node, and the predicate returns `ConfirmOnly`
         instead.

         DELIBERATELY environment-authored, not LHS-authored (a design note, not an accident):
         while authoring this fixture, an earlier draft with a `Segments`-shaped LHS ("aa" as one
         inline literal, reusing the SAME two-adjacent-identical-segment ambiguity
         `tests/phase_c_right_to_left.rs`'s own `rtl_distinct_leftmost_rightmost...` test proves
         direction-discriminating) was found NOT to round-trip through `pg_parse::Morpher` at all -
         the underlying, un-rewritten root shape parsed successfully UNCHANGED, and neither
         rewritten candidate parsed. This is the SAME pre-existing `pg_rules::rewrite::
         width_matches` limitation `rust/crates/pg-foma/src/replace.rs`'s own module doc already
         documents for a `Quantifier`-shaped LHS/RHS focus ("Confirm-engine finding": the analysis
         engine requires the matched span's PHYSICAL width to equal the rule's raw `lhs.nodes.len()`,
         a plain NODE count that is 1 for one `Segments` node regardless of how many physical
         segments it spans) - not a new gap, not RTL-specific, and outside `replace.rs`'s own
         single-owner boundary to fix here. This fixture instead places `Segments` in the
         ENVIRONMENT, exactly where `pg_rules::rewrite`'s own environment matching (`left_env_match`/
         `right_env_match`, `bridge.rs`'s `PatternBridge::compile_pattern`) tests first-match
         EXISTENCE only, never a positional per-node width array - the SAME reason
         `tests/phase_c_quantifier.rs`'s own bounded-quantifier fixture places ITS quantifier in an
         environment rather than the LHS/RHS focus, for the identical width-matching reason. The
         Segments-as-LHS ambiguity case is instead pinned directly at the FST/automaton level (no
         oracle dependency) by `tests/phase_c_right_to_left.rs`'s own
         `rtl_segments_lhs_differs_from_left_to_right_at_the_fst_level`. -->
    <PartsOfSpeech>
      <PartOfSpeech id="posN"><Name>N</Name></PartOfSpeech>
    </PartsOfSpeech>
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featId">
        <Name>id</Name>
        <Symbols>
          <Symbol id="symA">a</Symbol>
          <Symbol id="symE">e</Symbol>
          <Symbol id="symY">y</Symbol>
        </Symbols>
      </SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="ca"><Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featId" symbolValues="symA" />
        </SegmentDefinition>
        <SegmentDefinition id="ce"><Representations><Representation>e</Representation></Representations>
          <FeatureValue feature="featId" symbolValues="symE" />
        </SegmentDefinition>
        <SegmentDefinition id="cy"><Representations><Representation>y</Representation></Representations>
          <FeatureValue feature="featId" symbolValues="symY" />
        </SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <SegmentNaturalClass id="ncA"><Name>A</Name><Segment segment="ca" /></SegmentNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prRtlSegEnv" multipleApplicationOrder="rightToLeftIterative">
        <Name>rtlSegmentsEnvDemo</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncA" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><Segment segment="ce" /></PhoneticSequence></PhoneticOutput>
            <Environment><RightEnvironment><PhoneticTemplate><PhoneticSequence>
              <Segments characterDefinitionTable="t1"><PhoneticShape>y</PhoneticShape></Segments>
            </PhoneticSequence></PhoneticTemplate></RightEnvironment></Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t1" phonologicalRules="prRtlSegEnv">
        <Name>Main</Name>
        <LexicalEntries>
          <LexicalEntry id="eRoot1">
            <Allomorphs><Allomorph id="aRoot1"><PhoneticShape>ay</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT1</MorphemeId>
            <Gloss>root1</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eRoot2">
            <Allomorphs><Allomorph id="aRoot2"><PhoneticShape>a</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT2</MorphemeId>
            <Gloss>root2</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
