<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<!-- Synthetic. A narrowing rule whose LEFT-HAND SIDE starts with a morpheme boundary: a suffix-initial
     "b" becomes "m" after a nasal, written with the boundary inside the target,
       prPostNasal  + b -> m / [+nas] _
     (2 -> 1, the boundary is absorbed). Root KAN plus the suffix "+bo" surfaces as "kanmo"; so does
     KAN plus the suffix "+mo". Analysing "kanmo" must recover both: the "m" may be an underlying
     suffix "m", or a "+ b" that the rule rewrote. This is the ZERO-FEATURE twin of
     boundary-first-in-narrowing-lhs: with no PhonologicalFeatureSystem every segment is identified
     by its string representation alone, so a union of "m" with the structure of the boundary keeps
     the string set {m, +} and cannot stand in for "b". -->
<HermitCrabInput>
  <Language>
    <Name>BoundaryFirstInNarrowingLhsStrrep</Name>
    <PartsOfSpeech><PartOfSpeech id="posN"><Name>n</Name></PartOfSpeech></PartsOfSpeech>
    <CharacterDefinitionTable id="tbl">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cT"><Representations><Representation>t</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cB"><Representations><Representation>b</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cN"><Representations><Representation>n</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cM"><Representations><Representation>m</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cO"><Representations><Representation>o</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="bPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <SegmentNaturalClass id="ncAny"><Name>Any</Name><Segment segment="cK" /><Segment segment="cT" /><Segment segment="cB" /><Segment segment="cN" /><Segment segment="cM" /><Segment segment="cA" /><Segment segment="cO" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncNas"><Name>nasal</Name><Segment segment="cN" /><Segment segment="cM" /></SegmentNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prPostNasal">
        <Name>postNasalSuffixB</Name>
        <PhoneticInput><PhoneticSequence><BoundaryMarker boundary="bPlus" /><Segment segment="cB" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><Segment segment="cM" /></PhoneticSequence></PhoneticOutput>
            <Environment><LeftEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncNas" /></PhoneticSequence></PhoneticTemplate></LeftEnvironment></Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="tbl" morphologicalRuleOrder="unordered" morphologicalRules="mrSfxBo mrSfxMo" phonologicalRules="prPostNasal">
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrSfxBo" requiredPartsOfSpeech="posN" outputPartOfSpeech="posN">
            <Name>sfxBo</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subSfxBo">
                <MorphologicalInput><PhoneticSequence id="stemBo"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemBo" /><InsertSegments><PhoneticShape>+bo</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>BO</MorphemeId>
            <Gloss>bo</Gloss>
          </MorphologicalRule>
          <MorphologicalRule id="mrSfxMo" requiredPartsOfSpeech="posN" outputPartOfSpeech="posN">
            <Name>sfxMo</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subSfxMo">
                <MorphologicalInput><PhoneticSequence id="stemMo"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemMo" /><InsertSegments><PhoneticShape>+mo</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>MO</MorphemeId>
            <Gloss>mo</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="eKan" partOfSpeech="posN"><Allomorphs><Allomorph id="aKan"><PhoneticShape>kan</PhoneticShape></Allomorph></Allomorphs><MorphemeId>KAN</MorphemeId><Gloss>kan</Gloss></LexicalEntry>
          <LexicalEntry id="eKat" partOfSpeech="posN"><Allomorphs><Allomorph id="aKat"><PhoneticShape>kat</PhoneticShape></Allomorph></Allomorphs><MorphemeId>KAT</MorphemeId><Gloss>kat</Gloss></LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
