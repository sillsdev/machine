<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>TwoTableSharedRepresentationRecall</Name>
    <!-- Synthetic construct-shaped mimic (docs/conformance/representative-typology-basis.md
         S1.2.5 - "Multi-table: shared-representation-across-tables configuration"), the
         RECALL-side counterpart to `bistratal-overlapping-segment-representation` (which pins the
         REFUSAL/verdict side only, with each stratum's own lexicon deliberately independent - no
         rule threads material between its two tables). This fixture is the one that DOES thread
         material across tables: a root entered on the Inner stratum (table t0) must, to reach the
         surface at all, pass through the Outer stratum's (table t1) own obligatory phonological
         rule - and that rule's own natural classes are resolved against table t1, which spells
         the SAME segment ("x") at a DIFFERENT raw index than table t0 does.

         `docs/conformance/multitable-shared-representation-design.md`'s own headline finding is
         that `pg_foma::replace::SegAlphabet::token` (`PUA_BASE + cd.0`) is a pure function of a
         char-def's RAW PER-TABLE INDEX, blind to which table it came from - so, pre-fix, a rule
         compiled against table t1 renders its "x" atom using table t1's OWN index, and a root
         emitted from table t0 carries table t0's OWN index for "x": these differ, so the rule
         NEVER FIRES on the Inner-stratum root's material, and the FST proposer never proposes the
         devoiced ("y"-spelled) surface form the oracle (`pg_parse::Morpher`, which resolves every
         segment via genuine feature-lane unification, never a raw-index comparison) correctly
         finds. `crate::replace::RepresentationAliasMap`/`SegAlphabet::render_tokens` (render-time
         cross-table token aliasing) closes exactly this gap: the rule's "x" atom renders as a
         UNION over every table's own token for that spelling, so it fires on Inner-stratum
         material too.

         Structural shape: `Grammar::char_tables.len() == 2` ("Inner"/t0, "Outer"/t1, each
         stratum's own `StratumDef::table` pointing at a DIFFERENT table), NOT pairwise-disjoint
         (both declare "x"), and t1's own char-def ORDER is deliberately misaligned relative to t0
         ("z" declared FIRST in t1, so t1's own "x" sits at raw index 1, while t0's "x" sits at raw
         index 0) - the same "deliberately misaligned" construction
         `tests/two_table_symbol_divergence.rs`/`tests/phase_c_multi_table.rs` already use for the
         DISJOINT-representation case, applied here to a SHARED representation instead. -->
    <PartsOfSpeech>
      <PartOfSpeech id="posV"><Name>V</Name></PartOfSpeech>
    </PartsOfSpeech>
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featXY">
        <Name>xy</Name>
        <Symbols>
          <Symbol id="symX">x</Symbol>
          <Symbol id="symY">y</Symbol>
          <Symbol id="symZ">z</Symbol>
          <Symbol id="symQ">q</Symbol>
        </Symbols>
      </SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t0">
      <Name>Inner</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="c0x">
          <Representations><Representation>x</Representation></Representations>
          <FeatureValue feature="featXY" symbolValues="symX" />
        </SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <CharacterDefinitionTable id="t1">
      <Name>Outer</Name>
      <SegmentDefinitions>
        <!-- "z" declared FIRST so t1's own "x" (below) sits at raw index 1, not 0 - t0's "x" sits
             at raw index 0 (t0's only segment). Deliberately misaligned raw indices for the SAME
             spelling across the two tables (module doc). -->
        <SegmentDefinition id="c1z">
          <Representations><Representation>z</Representation></Representations>
          <FeatureValue feature="featXY" symbolValues="symZ" />
        </SegmentDefinition>
        <SegmentDefinition id="c1x">
          <Representations><Representation>x</Representation></Representations>
          <FeatureValue feature="featXY" symbolValues="symX" />
        </SegmentDefinition>
        <SegmentDefinition id="c1y">
          <Representations><Representation>y</Representation></Representations>
          <FeatureValue feature="featXY" symbolValues="symY" />
        </SegmentDefinition>
        <SegmentDefinition id="c1q">
          <Representations><Representation>q</Representation></Representations>
          <FeatureValue feature="featXY" symbolValues="symQ" />
        </SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncBx"><Name>OuterX</Name>
        <FeatureValue feature="featXY" symbolValues="symX" />
      </FeatureNaturalClass>
      <FeatureNaturalClass id="ncBy"><Name>OuterY</Name>
        <FeatureValue feature="featXY" symbolValues="symY" />
      </FeatureNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prXtoY">
        <Name>XtoY</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncBx" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><SimpleContext naturalClass="ncBy" /></PhoneticSequence></PhoneticOutput>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t0" morphologicalRuleOrder="unordered">
        <Name>Inner</Name>
        <LexicalEntries>
          <LexicalEntry id="eRoot1" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aRoot1"><PhoneticShape>x</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT1</MorphemeId>
            <Gloss>root1</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
      <Stratum characterDefinitionTable="t1" morphologicalRuleOrder="unordered" phonologicalRules="prXtoY">
        <Name>Outer</Name>
        <LexicalEntries>
          <LexicalEntry id="eRoot2" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aRoot2"><PhoneticShape>q</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT2</MorphemeId>
            <Gloss>root2</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
