				=ᇁ
				&ᄒ	# 1112 HIEUH(L) = 11C2 HIEUH(T)
				=ᇂ
				# Korean modern complex vowels, decompose
				&ᅡᅵ	# 1161 A(V) + 1175 I(V) = 1162 AE(V)
				=ᅢ
				&ᅣᅵ	# 1163 YA(V) + 1175 I(V) = 1164 YAE(V)
				=ᅤ
				&ᅥᅵ	# 1165 EO(V) + 1175 I(V) = 1166 E(V)
				=ᅦ
				&ᅧᅵ	# 1167 YEO(V) + 1175 I(V) = 1168 YE(V)
				=ᅨ
