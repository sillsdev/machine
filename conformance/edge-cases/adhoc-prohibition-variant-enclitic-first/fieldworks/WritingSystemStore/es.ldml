				=ᆼ
				&ᄌ	# 110C CIEUC(L) = 11BD CIEUC(T)
				=ᆽ
				&ᄌᄌ	# 110C CIEUC(L) + 110C CIEUC(L) = 110D SSANGCIEUC(L)
				=ᄍ
				&ᄎ	# 110E CHIEUCH(L) = 11BE CHIEUCH(T)
				=ᆾ
				&ᄏ	# 110F KHIEUKH(L) = 11BF KHIEUKH(T)
				=ᆿ
