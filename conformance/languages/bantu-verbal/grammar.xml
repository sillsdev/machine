          <LexicalEntry id="eSil" partOfSpeech="posV7">
            <Allomorphs><Allomorph id="aSil"><PhoneticShape>sil</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>SIL</MorphemeId>
            <Gloss>plant</Gloss>
          </LexicalEntry>
          <!-- G5 second sweep: mrStemReq (RequiredStemName). DAL's allomorph carries stemName="snG5";
