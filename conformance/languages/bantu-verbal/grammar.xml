        </AffixTemplates>
        <LexicalEntries>
          <!-- Nasal-prefix mutation + required-pos-subrule (posV): "mba"/"mpa" identical underlying
               shape "mpa", differing only by POS - posV's own confirm mutates p->b (nasal-mutation
               fires), posN-equivalent (posV is the ONLY POS gated for the subrule) never does. -->
          <LexicalEntry id="eMpaV" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aMpaV"><PhoneticShape>mpa</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>PAV</MorphemeId>
            <Gloss>hit</Gloss>
          </LexicalEntry>
          <!-- realizational/realizational-rule (posV2): "cultivate" (Swahili -lima-plausible). -->
          <LexicalEntry id="eLima" partOfSpeech="posV2">
            <Allomorphs><Allomorph id="aLima"><PhoneticShape>lima</PhoneticShape></Allomorph></Allomorphs>
