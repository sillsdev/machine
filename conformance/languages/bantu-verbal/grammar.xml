          </LexicalEntry>
          <LexicalEntry id="eBel" partOfSpeech="posV3" ruleFeatures="mprConcA mprConcC">
            <Allomorphs><Allomorph id="aBel"><PhoneticShape>bel</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>BEL</MorphemeId>
            <Gloss>root.bel</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eNal" partOfSpeech="posV3">
            <Allomorphs><Allomorph id="aNal"><PhoneticShape>nal</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>NAL</MorphemeId>
            <Gloss>root.nal</Gloss>
          </LexicalEntry>
          <!-- extension-slot ordering (posV4): "write" (Swahili -andika-plausible). -->
          <LexicalEntry id="eAndik" partOfSpeech="posV4">
            <Allomorphs><Allomorph id="aAndik"><PhoneticShape>andik</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>AND</MorphemeId>
            <Gloss>write</Gloss>
