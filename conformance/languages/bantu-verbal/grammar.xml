<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>Velamba</Name>
    <PartsOfSpeech>
      <!-- One POS per demo section, the same isolation discipline templatic-semitic/fusional-latin
           established. Only posV (the nasal-mutation pair) actually needs it for PHONOLOGICAL-rule
           isolation (prNasalMutation is this grammar's only phonological rule, gated to posV via its
           own PhonologicalSubrule's requiredPartsOfSpeech); posV2-posV5 are purely morphological
           sections (RealizationalRule/MorphologicalRule already gate themselves via their own
           requiredPartsOfSpeech), kept on separate POS anyway for the same defensive clarity -
           distinct affix literal strings across sections mean there is no actual collision risk, but
           the separation costs nothing and matches house style. -->
      <PartOfSpeech id="posV"><Name>vNasalMutation</Name></PartOfSpeech>
      <PartOfSpeech id="posV2"><Name>vRealizational</Name></PartOfSpeech>
      <PartOfSpeech id="posV3"><Name>vMprGroups</Name></PartOfSpeech>
      <PartOfSpeech id="posV4"><Name>vExtension</Name></PartOfSpeech>
      <PartOfSpeech id="posV5"><Name>vReduplication</Name></PartOfSpeech>
      <PartOfSpeech id="posV6"><Name>vAgreement</Name></PartOfSpeech>
      <!-- G5 (code-coverage-driven, second sweep): mrRecurSuf/mrStemReq below. -->
      <PartOfSpeech id="posV7"><Name>vSecondSweep</Name></PartOfSpeech>
    </PartsOfSpeech>
    <!-- A fully-specified PhonologicalFeatureSystem (the G2a finding, restated in templatic-semitic's
         own header): prNasalMutation's Voiceless->Voiced subrule CHANGES a segment's identity via a
         FeatureNaturalClass, so every segment needs a unique, fully-specified bundle. featNasal is a
         dedicated binary (not folded into featPlace) so ncNasal can classify "m OR n" with a single
         FeatureValue constraint, matching v1 rewrite/simultaneous-epenthesis's own featNasal
         precedent; featPlace + featVoice make every consonant otherwise unique, exactly Kirenti's
         technique. -->
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featCons"><Name>cons</Name><Symbols><Symbol id="fConsPlus">+</Symbol><Symbol id="fConsMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoc"><Name>voc</Name><Symbols><Symbol id="fVocPlus">+</Symbol><Symbol id="fVocMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featHigh"><Name>high</Name><Symbols><Symbol id="fHighPlus">+</Symbol><Symbol id="fHighMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featBack"><Name>back</Name><Symbols><Symbol id="fBackPlus">+</Symbol><Symbol id="fBackMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoice"><Name>voice</Name><Symbols><Symbol id="fVoicePlus">+</Symbol><Symbol id="fVoiceMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featNasal"><Name>nasal</Name><Symbols><Symbol id="fNasalPlus">+</Symbol><Symbol id="fNasalMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featPlace">
        <Name>place</Name>
        <Symbols>
          <Symbol id="fPlaceBilabial">bilabial</Symbol>
          <Symbol id="fPlaceDental">dental</Symbol>
          <Symbol id="fPlaceSibilant">sibilant</Symbol>
          <Symbol id="fPlaceNasalM">nasalM</Symbol>
          <Symbol id="fPlaceNasalN">nasalN</Symbol>
          <Symbol id="fPlaceLateral">lateral</Symbol>
          <Symbol id="fPlaceGlottal">glottal</Symbol>
          <Symbol id="fPlaceVelar">velar</Symbol>
          <Symbol id="fPlaceLabiovelar">labiovelar</Symbol>
          <Symbol id="fPlacePalatal">palatal</Symbol>
          <Symbol id="fPlaceUvular">uvular</Symbol>
          <Symbol id="fPlaceVocalic">vocalic</Symbol>
        </Symbols>
      </SymbolicFeature>
    </PhonologicalFeatureSystem>
    <!-- realizational/realizational-rule: featTense, mirroring v1's own grammar exactly (mrTense
         ordinary + rrPast realizational, IsBlocked's presence-only check). -->
    <HeadFeatures>
      <SymbolicFeature id="featTense">
        <Name>tense</Name>
        <Symbols>
          <Symbol id="symPres">pres</Symbol>
          <Symbol id="symPast">past</Symbol>
        </Symbols>
      </SymbolicFeature>
      <!-- Syntactic feature agreement (G5, code-coverage-driven; posV6 below): a HeadFeature the
           agreement chain assigns then requires, mirroring Bantu noun-class-style subject
           agreement (a plural marker must land before an agreement suffix can attach). -->
      <SymbolicFeature id="featNum">
        <Name>num</Name>
        <Symbols>
          <Symbol id="symSg">sg</Symbol>
          <Symbol id="symPl">pl</Symbol>
        </Symbols>
      </SymbolicFeature>
      <!-- G5 (code-coverage-driven, second sweep): rrRRealTest's own RequiredHeadFeatures, distinct
           from featNum above so this second-sweep material can never interact with posV6's chain. -->
      <SymbolicFeature id="featG5">
        <Name>g5</Name>
        <Symbols>
          <Symbol id="symG5A">g5a</Symbol>
          <Symbol id="symG5B">g5b</Symbol>
        </Symbols>
      </SymbolicFeature>
    </HeadFeatures>
    <!-- FootFeatures (G5, code-coverage-driven): no existing grammar in the suite declared this
         top-level section at all (SyntacticFeatureSystem.AddFootFeature/FootFeature/FootFeatures
         were all at zero coverage). featStress is assigned/required by the same posV6 agreement
         chain as featNum above, alongside it rather than instead of it, so both the head- and
         foot-feature agreement code paths are exercised together. -->
    <FootFeatures>
      <SymbolicFeature id="featStress">
        <Name>stress</Name>
        <Symbols>
          <Symbol id="symStressed">stressed</Symbol>
          <Symbol id="symUnstressed">unstressed</Symbol>
        </Symbols>
      </SymbolicFeature>
    </FootFeatures>
    <!-- mpr-groups/output-overwrite: ExtGroup (2-member, outputType="overwrite" is the DTD default,
         spelled out for clarity) - applying mrExtY drops mprExtA rather than accumulating it.
         mpr-groups/required-all: AllConc (matchType="all") and AnyConc (matchType="any", the DTD
         default, spelled out for symmetry) - two rules gated by ALL/ANY group membership
         respectively. morphologicalRuleOrder="linear" (the DTD's own default, see Stratum below) is
         load-bearing for ExtGroup's Overwrite to be observable at all (the ledger's own note on this
         row) - unlike fusional-latin, nothing else in this grammar needs "unordered", so one shared
         stratum suffices (no split required). -->
    <MorphologicalPhonologicalRuleFeatures>
      <MorphologicalPhonologicalRuleFeature id="mprExtA">ExtA</MorphologicalPhonologicalRuleFeature>
      <MorphologicalPhonologicalRuleFeature id="mprExtB">ExtB</MorphologicalPhonologicalRuleFeature>
      <MorphologicalPhonologicalRuleFeature id="mprConcA">ConcA</MorphologicalPhonologicalRuleFeature>
      <MorphologicalPhonologicalRuleFeature id="mprConcB">ConcB</MorphologicalPhonologicalRuleFeature>
      <MorphologicalPhonologicalRuleFeature id="mprConcC">ConcC</MorphologicalPhonologicalRuleFeature>
      <MorphologicalPhonologicalRuleFeature id="mprConcD">ConcD</MorphologicalPhonologicalRuleFeature>
      <!-- G5 (code-coverage-driven, second sweep): gates mrRRealTest below (SynthesisRealizationalAffixProcessRule),
           a hard set-membership check so that rule can never spuriously apply to any pre-existing
           word (RequiredHeadFeatures/RealizationalFeatures unify vacuously against a feature no
           other entry ever sets, per the mrAgr/dabez finding above, but requiredMPRFeatures is a
           genuine set-membership gate, not unification). -->
      <MorphologicalPhonologicalRuleFeature id="mprRRealTest">RRealTest</MorphologicalPhonologicalRuleFeature>
      <MorphologicalPhonologicalRuleFeatureGroup isActive="yes" matchType="any" outputType="overwrite" features="mprExtA mprExtB"><Name>ExtGroup</Name></MorphologicalPhonologicalRuleFeatureGroup>
      <MorphologicalPhonologicalRuleFeatureGroup isActive="yes" matchType="all" outputType="overwrite" features="mprConcA mprConcB"><Name>AllConc</Name></MorphologicalPhonologicalRuleFeatureGroup>
      <MorphologicalPhonologicalRuleFeatureGroup isActive="yes" matchType="any" outputType="overwrite" features="mprConcC mprConcD"><Name>AnyConc</Name></MorphologicalPhonologicalRuleFeatureGroup>
    </MorphologicalPhonologicalRuleFeatures>
    <!-- G5 (code-coverage-driven, second sweep): snG5 gates mrStemReq below
         (SynthesisAffixProcessRule.RequiredStemName), previously zero coverage for the FAILURE case
         (a candidate root without the required stem name). Region carries no AssignedHeadFeatures:
         RootAllomorph.CheckAllomorphConstraints (StemName.IsRequiredMatch) unifies the region against
         the word's SyntacticFeatureStruct at root-selection time, and posV7 alone (already on the
         region via partsOfSpeech) is all we want to require; adding a tense feature there would gate
         root selection itself on a feature nothing in this derivation ever assigns, masking the
         RequiredStemName rule-level check (SynthesisAffixProcessRule) this fixture actually targets. -->
    <StemNames>
      <StemName id="snG5" partsOfSpeech="posV7">
        <Name>G5Stem</Name>
        <Regions>
          <Region></Region>
        </Regions>
      </StemName>
    </StemNames>
    <CharacterDefinitionTable id="table1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <!-- Vowels: a/e/i distinguished by (high,back) alone - no "u"/"o" needed anywhere in this
             grammar, so no featRound is declared at all (unlike templatic-semitic, which needed it
             for its feeding-pair construct; this grammar carries no such construct). -->
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsMinus" /><FeatureValue feature="featVoc" symbolValues="fVocPlus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackPlus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceVocalic" />
        </SegmentDefinition>
        <SegmentDefinition id="cE"><Representations><Representation>e</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsMinus" /><FeatureValue feature="featVoc" symbolValues="fVocPlus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceVocalic" />
        </SegmentDefinition>
        <SegmentDefinition id="cI"><Representations><Representation>i</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsMinus" /><FeatureValue feature="featVoc" symbolValues="fVocPlus" />
          <FeatureValue feature="featHigh" symbolValues="fHighPlus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceVocalic" />
        </SegmentDefinition>
        <!-- Consonants: high/back are filler "-" (irrelevant, but full-specification requires an
             explicit value); featPlace + featVoice + featNasal jointly make every one of the 13
             unique. -->
        <SegmentDefinition id="cB"><Representations><Representation>b</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
        </SegmentDefinition>
        <SegmentDefinition id="cP"><Representations><Representation>p</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
        </SegmentDefinition>
        <SegmentDefinition id="cD"><Representations><Representation>d</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceDental" />
        </SegmentDefinition>
        <SegmentDefinition id="cS"><Representations><Representation>s</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceSibilant" />
        </SegmentDefinition>
        <SegmentDefinition id="cZ"><Representations><Representation>z</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceSibilant" />
        </SegmentDefinition>
        <SegmentDefinition id="cM"><Representations><Representation>m</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalPlus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceNasalM" />
        </SegmentDefinition>
        <SegmentDefinition id="cN"><Representations><Representation>n</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalPlus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceNasalN" />
        </SegmentDefinition>
        <SegmentDefinition id="cL"><Representations><Representation>l</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceLateral" />
        </SegmentDefinition>
        <SegmentDefinition id="cH"><Representations><Representation>h</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceGlottal" />
        </SegmentDefinition>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceVelar" />
        </SegmentDefinition>
        <SegmentDefinition id="cW"><Representations><Representation>w</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceLabiovelar" />
        </SegmentDefinition>
        <SegmentDefinition id="cY"><Representations><Representation>y</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlacePalatal" />
        </SegmentDefinition>
        <SegmentDefinition id="cX"><Representations><Representation>x</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoc" symbolValues="fVocMinus" />
          <FeatureValue feature="featHigh" symbolValues="fHighMinus" /><FeatureValue feature="featBack" symbolValues="fBackMinus" />
          <FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featNasal" symbolValues="fNasalMinus" />
          <FeatureValue feature="featPlace" symbolValues="fPlaceUvular" />
        </SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
      <!-- rewrite/required-pos-subrule + nasal-prefix mutation: env-only class (never a changing
           subrule's own target/output), matches "m" or "n". -->
      <FeatureNaturalClass id="ncNasal"><Name>Nasal</Name>
        <FeatureValue feature="featNasal" symbolValues="fNasalPlus" />
      </FeatureNaturalClass>
      <!-- prNasalMutation's target ("p") and output ("b") - CHANGING subrule, needs a fully-specified
           single-segment class each (the G2a finding). -->
      <FeatureNaturalClass id="ncVoicelessBilabial"><Name>VoicelessBilabial</Name>
        <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoice" symbolValues="fVoiceMinus" />
        <FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
      </FeatureNaturalClass>
      <FeatureNaturalClass id="ncVoicedBilabial"><Name>VoicedBilabial</Name>
        <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoice" symbolValues="fVoicePlus" />
        <FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
      </FeatureNaturalClass>
    </NaturalClasses>
    <Families>
      <!-- G5 (code-coverage-driven, second sweep): ZAM (regular) and WEP (suppletive) share this
           family so SynthesisRealizationalAffixProcessRule's OWN Blockable/CheckBlocking path gets
           exercised (previously only ever exercised through an ordinary MorphologicalRule or a
           CompoundingRule elsewhere in the suite, never a RealizationalRule). -->
      <Family id="famRRealBlock">FamRRealBlock</Family>
    </Families>
    <PhonologicalRuleDefinitions>
      <!-- rewrite/required-pos-subrule + nasal-prefix mutation (Celtic-style mutation coverage rides
           here, per the roster): post-nasal voicing of a stem-initial voiceless stop, a genuine,
           well-documented Bantu phenomenon (Bantu/Dahl's-Law-style post-nasal hardening/voicing) -
           the nasal (a historical subject-agreement/noun-class prefix) is modeled as already fused
           into the root's own stored shape for a controlled minimal pair, mirroring v1's own
           rootV/rootN bare-shape minimalism exactly. Scoped to posV only via the subrule's own
           requiredPartsOfSpeech, so the identically-shaped posV2-posV5 material is never touched. -->
      <PhonologicalRule id="prNasalMutation">
        <Name>nasalMutation</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncVoicelessBilabial" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule requiredPartsOfSpeech="posV">
            <PhoneticOutput><PhoneticSequence><SimpleContext naturalClass="ncVoicedBilabial" /></PhoneticSequence></PhoneticOutput>
            <Environment>
              <LeftEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncNasal" /></PhoneticSequence></PhoneticTemplate></LeftEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum
        characterDefinitionTable="table1"
        morphologicalRuleOrder="linear"
        morphologicalRules="mrTense rrPast mrExtX mrExtY mrEndZ mrEndW mrEndH mrRedup mrCaus mrAppl mrFV mrNumPl mrAgr mrRecurSuf mrStemReq rrRRealTest"
        phonologicalRules="prNasalMutation"
      >
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <!-- ===================== realizational/realizational-rule ===================== -->
          <MorphologicalRule id="mrTense" requiredPartsOfSpeech="posV2" outputPartOfSpeech="posV2">
            <Name>tense</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subTense">
                <MorphologicalInput><PhoneticSequence id="stemTense"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemTense" /><InsertSegments><PhoneticShape>pe</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <OutputHeadFeatures><FeatureValue feature="featTense" symbolValues="symPres" /></OutputHeadFeatures>
            <MorphemeId>TENSE</MorphemeId>
          </MorphologicalRule>
          <RealizationalRule id="rrPast">
            <Name>realizPast</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subRPast">
                <MorphologicalInput><PhoneticSequence id="stemRPast"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemRPast" /><InsertSegments><PhoneticShape>ile</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <RealizationalFeatures><FeatureValue feature="featTense" symbolValues="symPast" /></RealizationalFeatures>
            <MorphemeId>RPAST</MorphemeId>
          </RealizationalRule>
          <!-- ===================== mpr-groups/output-overwrite ===================== -->
          <MorphologicalRule id="mrExtX" requiredPartsOfSpeech="posV3" outputPartOfSpeech="posV3">
            <Name>extX</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subExtX">
                <MorphologicalInput><PhoneticSequence id="stemExtX"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput MPRFeatures="mprExtA"><InsertSegments><PhoneticShape>x</PhoneticShape></InsertSegments><CopyFromInput index="stemExtX" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>EXTX</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrExtY" requiredPartsOfSpeech="posV3" outputPartOfSpeech="posV3">
            <Name>extY</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subExtY">
                <MorphologicalInput><PhoneticSequence id="stemExtY"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput MPRFeatures="mprExtB"><InsertSegments><PhoneticShape>y</PhoneticShape></InsertSegments><CopyFromInput index="stemExtY" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>EXTY</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrEndZ" requiredPartsOfSpeech="posV3" outputPartOfSpeech="posV3">
            <Name>endZ</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subEndZ">
                <MorphologicalInput requiredMPRFeatures="mprExtA"><PhoneticSequence id="stemEndZ"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemEndZ" /><InsertSegments><PhoneticShape>z</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>ENDZ</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== mpr-groups/required-all ===================== -->
          <MorphologicalRule id="mrEndW" requiredPartsOfSpeech="posV3" outputPartOfSpeech="posV3">
            <Name>endW</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subEndW">
                <MorphologicalInput requiredMPRFeatures="mprConcA mprConcB"><PhoneticSequence id="stemEndW"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemEndW" /><InsertSegments><PhoneticShape>w</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>ENDW</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrEndH" requiredPartsOfSpeech="posV3" outputPartOfSpeech="posV3">
            <Name>endH</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subEndH">
                <MorphologicalInput requiredMPRFeatures="mprConcC mprConcD"><PhoneticSequence id="stemEndH"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemEndH" /><InsertSegments><PhoneticShape>h</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>ENDH</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== verbal reduplication (ReduplicationHint, zero coverage today) =====================
               Full-stem reduplication (intensive/repetitive aspect, Swahili kimbia/kimbiakimbia
               "run"/"run about repeatedly"-plausible): ONE MorphologicalInput part (the whole stem),
               copied twice in the output. redupMorphType="suffix": the SECOND occurrence is treated
               as the rule's own new morph (confirmed empirically, see words.yaml header). -->
          <MorphologicalRule id="mrRedup" requiredPartsOfSpeech="posV5" outputPartOfSpeech="posV5">
            <Name>redup</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subRedup">
                <MorphologicalInput><PhoneticSequence id="redupStem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput redupMorphType="suffix"><CopyFromInput index="redupStem" /><CopyFromInput index="redupStem" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>RED</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== extension-slot ordering (Bantu CARP-style: Causative before
               Applicative, both before the obligatory Final Vowel) ===================== -->
          <MorphologicalRule id="mrCaus" requiredPartsOfSpeech="posV4" outputPartOfSpeech="posV4">
            <Name>causative</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subCaus">
                <MorphologicalInput><PhoneticSequence id="stemCaus"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemCaus" /><InsertSegments><PhoneticShape>ish</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>CAUS</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrAppl" requiredPartsOfSpeech="posV4" outputPartOfSpeech="posV4">
            <Name>applicative</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subAppl">
                <MorphologicalInput><PhoneticSequence id="stemAppl"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemAppl" /><InsertSegments><PhoneticShape>il</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>APPL</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrFV" requiredPartsOfSpeech="posV4" outputPartOfSpeech="posV4">
            <Name>finalVowel</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subFV">
                <MorphologicalInput><PhoneticSequence id="stemFV"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemFV" /><InsertSegments><PhoneticShape>a</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>FV</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== syntactic feature agreement (G5, code-coverage-driven) =====================
               mrNumPl assigns featNum=pl (OutputHeadFeatures) and featStress=stressed
               (OutputFootFeatures) to the word it produces; mrAgr only applies to a word that
               already carries BOTH (RequiredHeadFeatures/RequiredFootFeatures), so "root-AGR"
               without the intervening "root-NUMPL" first has no analysis that satisfies mrAgr's
               requirement and gets zero parses (see words.yaml). -->
          <MorphologicalRule id="mrNumPl" requiredPartsOfSpeech="posV6" outputPartOfSpeech="posV6" outputObligatoryFeatures="featNum">
            <Name>numPl</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subNumPl">
                <MorphologicalInput><PhoneticSequence id="stemNumPl"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemNumPl" /><InsertSegments><PhoneticShape>ep</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <OutputHeadFeatures><FeatureValue feature="featNum" symbolValues="symPl" /></OutputHeadFeatures>
            <OutputFootFeatures><FeatureValue feature="featStress" symbolValues="symStressed" /></OutputFootFeatures>
            <MorphemeId>NUMPL</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrAgr" requiredPartsOfSpeech="posV6" outputPartOfSpeech="posV6">
            <Name>agr</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subAgr">
                <MorphologicalInput><PhoneticSequence id="stemAgr"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemAgr" /><InsertSegments><PhoneticShape>ez</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <RequiredHeadFeatures><FeatureValue feature="featNum" symbolValues="symPl" /></RequiredHeadFeatures>
            <RequiredFootFeatures><FeatureValue feature="featStress" symbolValues="symStressed" /></RequiredFootFeatures>
            <MorphemeId>AGR</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== G5 second sweep: MaxApplicationCount (SynthesisAffixProcessRule) =====================
               Ordinary suffix, same POS in and out so it can (in principle) reapply to its own
               output; the DTD's own default multipleApplication="1" caps it to exactly one
               application per derivation. -->
          <MorphologicalRule id="mrRecurSuf" requiredPartsOfSpeech="posV7" outputPartOfSpeech="posV7">
            <Name>recurSuf</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subRecurSuf">
                <MorphologicalInput><PhoneticSequence id="stemRecurSuf"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemRecurSuf" /><InsertSegments><PhoneticShape>iz</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>RECURSUF</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== G5 second sweep: RequiredStemName failure (SynthesisAffixProcessRule) =====================
               requiredStemName="snG5" only applies to a root whose SELECTED allomorph carries that
               exact stem name (see StemNames above); DAH's allomorph carries none at all. -->
          <MorphologicalRule id="mrStemReq" requiredPartsOfSpeech="posV7" outputPartOfSpeech="posV7" requiredStemName="snG5">
            <Name>stemReq</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subStemReq">
                <MorphologicalInput><PhoneticSequence id="stemStemReq"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemStemReq" /><InsertSegments><PhoneticShape>eh</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>STEMREQ</MorphemeId>
          </MorphologicalRule>
          <!-- ===================== G5 second sweep: RequiredSyntacticFeatureStruct failure + Blockable
               (SynthesisRealizationalAffixProcessRule) =====================
               Gated by requiredMPRFeatures="mprRRealTest" on the subrule's own MorphologicalInput so
               this rule can never spuriously apply to any other word in the grammar (RealizationalRule
               has no requiredPartsOfSpeech attribute at all; see the MorphologicalPhonologicalRuleFeatures
               comment above for why a hard MPR gate, not RequiredHeadFeatures, is what makes this safe).
               RequiredHeadFeatures featG5=symG5B: ZIM (AssignedHeadFeatures featG5=symG5A) genuinely
               conflicts and fails; ZAM (featG5=symG5B) matches and succeeds, then hits Blockable via
               famRRealBlock (WEP, the suppletive partner). -->
          <RealizationalRule id="rrRRealTest">
            <Name>rRealTest</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subRRealTest">
                <MorphologicalInput requiredMPRFeatures="mprRRealTest"><PhoneticSequence id="stemRRealTest"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemRRealTest" /><InsertSegments><PhoneticShape>ed</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <RequiredHeadFeatures><FeatureValue feature="featG5" symbolValues="symG5B" /></RequiredHeadFeatures>
            <MorphemeId>RREALTEST</MorphemeId>
          </RealizationalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate requiredPartsOfSpeech="posV4">
            <Name>extensionTemplate</Name>
            <Slot optional="true" morphologicalRules="mrCaus"><Name>causative</Name></Slot>
            <Slot optional="true" morphologicalRules="mrAppl"><Name>applicative</Name></Slot>
            <Slot morphologicalRules="mrFV"><Name>finalVowel</Name></Slot>
