          <!-- verbal reduplication (posV5): "run/flee" (Swahili -kimbia-plausible). -->
          <LexicalEntry id="eKimbia" partOfSpeech="posV5">
            <Allomorphs><Allomorph id="aKimbia"><PhoneticShape>kimbia</PhoneticShape></Allomorph></Allomorphs>
