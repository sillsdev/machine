          <LexicalEntry id="eDal" partOfSpeech="posV7">
            <Allomorphs><Allomorph id="aDal" stemName="snG5"><PhoneticShape>dal</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>DAL</MorphemeId>
            <Gloss>dig</Gloss>
          </LexicalEntry>
