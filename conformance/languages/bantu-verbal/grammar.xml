            <AssignedFootFeatures><FeatureValue feature="featStress" symbolValues="symUnstressed" /></AssignedFootFeatures>
            <MorphemeId>KES</MorphemeId>
            <Gloss>sing</Gloss>
          </LexicalEntry>
