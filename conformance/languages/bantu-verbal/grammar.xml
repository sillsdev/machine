          <LexicalEntry id="eKib" partOfSpeech="posV3" ruleFeatures="mprConcA mprConcB">
            <Allomorphs><Allomorph id="aKib"><PhoneticShape>kib</PhoneticShape></Allomorph></Allomorphs>
