                  <InsertSegments><PhoneticShape>a</PhoneticShape></InsertSegments>
                  <CopyFromInput index="pfC2" />
                  <InsertSegments><PhoneticShape>a</PhoneticShape></InsertSegments>
                  <CopyFromInput index="pfC3" />
                  <InsertSegments><PhoneticShape>ɯd</PhoneticShape></InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>PERF</MorphemeId>
          </MorphologicalRule>
