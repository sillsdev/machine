                <MorphologicalInput><PhoneticSequence id="lnkStem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="lnkStem" /><InsertSegments><PhoneticShape>in</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>LNK</MorphemeId>
          </MorphologicalRule>
          <!-- affix-shapes/noncontiguous morphology: a triconsonantal root gets an "a" inserted after
               C1 and C2 plus a trailing "ɯd" suffix (k+a+t+a+b+ɯd = katabɯd), then prNonContig raises
