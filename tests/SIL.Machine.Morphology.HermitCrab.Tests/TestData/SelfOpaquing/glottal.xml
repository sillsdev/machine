                <PhoneticTemplate>
                  <PhoneticSequence>
                    <SimpleContext naturalClass="vowels" />
                  </PhoneticSequence>
                </PhoneticTemplate>
              </RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="tbl" morphologicalRuleOrder="unordered" phonologicalRules="postC">
        <Name>Core</Name>
        <LexicalEntries>
          <LexicalEntry id="POSTC" partOfSpeech="posN">
            <Allomorphs>
              <Allomorph id="alloPOSTC">
                <PhoneticShape>ʔa</PhoneticShape>
              </Allomorph>
            </Allomorphs>
            <MorphemeId>POSTC</MorphemeId>
            <Gloss>POSTC</Gloss>
