          <Representations>
            <Representation>a</Representation>
          </Representations>
          <FeatureValue feature="vocalic" symbolValues="vocalic_yes" />
        </SegmentDefinition>
        <SegmentDefinition id="q">
          <Representations>
            <Representation>ʔ</Representation>
          </Representations>
          <FeatureValue feature="vocalic" symbolValues="vocalic_no" />
        </SegmentDefinition>
        <SegmentDefinition id="dash">
