<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>SIL.Machine.Morphology.HermitCrab.Conformance</RootNamespace>
		<AssemblyName>hc-conformance</AssemblyName>
		<Description>Runs the HermitCrab conformance suite (the clone in conformance/) against the C# engine.</Description>
		<PackageId>SIL.Machine.Morphology.HermitCrab.Conformance</PackageId>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
	</PropertyGroup>

	<Import Project="../AssemblyInfo.props" />

	<ItemGroup>
		<ProjectReference Include="..\SIL.Machine.Morphology.HermitCrab\SIL.Machine.Morphology.HermitCrab.csproj" />
		<ProjectReference Include="..\SIL.Machine.Morphology.HermitCrab.Tool\SIL.Machine.Morphology.HermitCrab.Tool.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- words.yaml is parsed with YamlDotNet and checked against the suite's JSON schemas with
		     JsonSchema.Net, dependencies scoped to this project since no other project needs them. -->
		<PackageReference Include="JsonSchema.Net" Version="9.4.0" />
		<PackageReference Include="YamlDotNet" Version="16.3.0" />
	</ItemGroup>

	<Import Project="EnsureConformanceSuite.targets" />

</Project>
